# Cloudflare Stream (API token requires Stream Read + Stream Write)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_stream_api_token
CLOUDFLARE_STREAM_CUSTOMER_CODE=customer-xxxxxxxxxxxxxxxx

# Vivad Video authentication. This is the same token endpoint used by SAV
# Builder. It will be replaced by STRAPI authentication later.
AUTH_PROVIDER=vivad
VIVAD_AUTH_URL=https://your-vivad-auth-service.example/api/auth/token
# Google Sheets query endpoint used server-side to return only the matching
# email and Vivad Video role from Lotus_Directory.
LOTUS_DIRECTORY_QUERY_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/gviz/tq?gid=0
LOTUS_DIRECTORY_EMAIL_COLUMN=A
LOTUS_DIRECTORY_ROLE_COLUMN=J
AUTH_DISPLAY_NAME=Vivad user
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-bytes
EMBED_SIGNING_SECRET=replace-with-a-different-32-byte-secret
SHARE_SIGNING_SECRET=replace-with-a-third-32-byte-secret
PUBLIC_APP_URL=https://vivad-video.netlify.app

# iRedMail SMTP submission
SMTP_HOST=iredmail.vivad.com.au
SMTP_PORT=587
SMTP_USER=ewend@vivad.com.au
SMTP_PASS=your-iredmail-password
SMTP_FROM_NAME=Vivad Video
SMTP_FROM_EMAIL=ewend@vivad.com.au

# Optional comma-separated Stream display origins. PUBLIC_APP_URL and the
# customer Stream hostname are added automatically whenever this is restricted.
STREAM_ALLOWED_ORIGINS=

# Production persistence for the video catalogue, upload state and audit events.
# Netlify Database supplies NETLIFY_DB_URL automatically. VIDEO_DATABASE_URL
# remains supported when using another PostgreSQL provider.
NETLIFY_DB_URL=
VIDEO_DATABASE_URL=

# Optional Strapi 5 draft publishing destination
STRAPI_URL=
STRAPI_API_TOKEN=
STRAPI_VIDEO_CONTENT_TYPE=videos

# Optional future Discourse publishing adapter (copy/share works without these)
DISCOURSE_URL=
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=

# Optional future FFmpeg/container rendering service
RENDERING_SERVICE_URL=
RENDERING_SERVICE_TOKEN=
