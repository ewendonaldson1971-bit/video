# Cloudflare Stream (API token requires Stream Read + Stream Write)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_stream_api_token
CLOUDFLARE_STREAM_CUSTOMER_CODE=customer-xxxxxxxxxxxxxxxx

# Vivad Video authentication. This is the same token endpoint used by SAV
# Builder. It will be replaced by STRAPI authentication later.
AUTH_PROVIDER=vivad
VIVAD_AUTH_URL=https://your-vivad-auth-service.example/api/auth/token
AUTH_DISPLAY_NAME=Vivad user
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-bytes
EMBED_SIGNING_SECRET=replace-with-a-different-32-byte-secret

# iRedMail SMTP submission
SMTP_HOST=iredmail.vivad.com.au
SMTP_PORT=587
SMTP_USER=ewend@vivad.com.au
SMTP_PASS=your-iredmail-password
SMTP_FROM_NAME=Vivad Video
SMTP_FROM_EMAIL=ewend@vivad.com.au

# Optional comma-separated Stream display origins. Include the customer Stream
# hostname if you restrict origins and want emailed watch links to work.
STREAM_ALLOWED_ORIGINS=
